[Unit]
Description=EuroMillions Grille vs Tirage
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/euromillions-checker/backend
ExecStart=/home/pi/euromillions-checker/backend/venv/bin/waitress-serve --host=0.0.0.0 --port=5000 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
